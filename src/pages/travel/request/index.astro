---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Request a Courier">
    <h1>Request a Courier</h1>
    <p>Flying somewhere soon? Let us know your destination and travel date and we'll see if there are any packages that need to reach a mission in your area.</p>

    <form id="request-form" action="https://formsubmit.co/pouchday-dev@proton.me" method="POST">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_subject" value="New Courier Request">
        <input type="hidden" name="_next" id="request-next" value="/travel/request/success/">

        <div class="form-group">
            <label for="field-mission">Mission Destination</label>
            <select name="mission" id="field-mission" required>
                <option value="" disabled selected>Loading missions…</option>
            </select>
        </div>

        <div class="form-group">
            <label for="field-travel-date">Travel Date</label>
            <input type="date" name="travel_date" id="field-travel-date" class="travel-date-input" required>
        </div>

        <div class="form-group">
            <label for="field-capacity">Luggage Capacity</label>
            <select name="capacity" id="field-capacity">
                <option value="Small Item">I can take a small item</option>
                <option value="Extra Suitcase">I can check an extra bag</option>
            </select>
        </div>

        <div class="form-group">
            <label for="field-email">Your Email</label>
            <input type="email" name="email" id="field-email" placeholder="you@example.com" required>
        </div>

        <button type="submit" class="btn-primary">Submit Request</button>
    </form>
</Layout>

<style>
.travel-date-input {
    max-width: 200px;
}

@media (max-width: 768px) {
    .travel-date-input {
        max-width: 100%;
    }
}
</style>

<script>
// Fix absolute redirect for FormSubmit
const requestNext = document.getElementById('request-next');
if (requestNext) {
    requestNext.value = `${window.location.origin}/travel/request/success/`;
}

const MISSIONS_TSV_URL = 'https://docs.google.com/spreadsheets/d/1pNKEJRMOZY2yTuOt91vOZ9qeRW5S9oVaF9NnkLsoEOc/export?gid=0&format=tsv';
const missionSelect = document.getElementById('field-mission');

fetch(MISSIONS_TSV_URL)
    .then(r => r.text())
    .then(text => {
        const lines = text.trim().split('\n');
        if (lines.length < 2) {
            missionSelect.innerHTML = '<option value="" disabled selected>No missions available</option>';
            return;
        }

        const headers = lines[0].split('\t').map(h => h.trim());
        const rows = lines.slice(1).map(line => line.split('\t').map(c => c.trim()));

        function findIdx(keywords, skip) {
            return headers.findIndex((h, i) => i !== skip && keywords.some(k => h.toLowerCase().includes(k)));
        }

        const nameIdx = findIdx(['mission', 'name'], -1);
        const activeIdx = headers.findIndex((h, i) => {
            if (i === nameIdx) return false;
            return ['active', 'available', 'accepting'].some(k => h.toLowerCase().includes(k));
        });

        missionSelect.innerHTML = '<option value="" disabled selected>Select a mission…</option>';

        rows.forEach(cols => {
            const missionName = cols[nameIdx >= 0 ? nameIdx : 0];
            if (!missionName) return;

            const rawActive = activeIdx >= 0 ? cols[activeIdx] : '';
            const isAvailable = rawActive === '' || rawActive.toLowerCase() !== 'false';

            const opt = document.createElement('option');
            opt.value = missionName;
            opt.textContent = isAvailable ? missionName : `${missionName} (Unavailable)`;
            opt.disabled = !isAvailable;
            missionSelect.appendChild(opt);
        });
    })
    .catch(() => {
        missionSelect.innerHTML = '<option value="" disabled selected>Unable to load missions</option>';
    });
</script>