---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="You're on the list!">
    <main class="success-message">
        <div class="success-icon">✈️</div>
        
        <h1>You're on the list!</h1>
        <p>Thanks for signing up. Our team will reach out to you with details about the trip.</p>

        <div class="card success-card">
            <h3>What's Next?</h3>
            <ul>
                <li>We'll email you within 24 hours with trip details</li>
                <li>You'll receive package information closer to the travel date</li>
                <li>All expenses will be covered by PouchDay</li>
            </ul>
        </div>
        
        <div class="card success-card">
            <h3>Stay Connected</h3>
            <p>Follow us on social to see updates, needs, and future opportunities to help.</p>
            <div class="social-links" aria-label="Social media links">
                <a class="social-link" href="https://instagram.com/pouchday" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="1"></circle>
                    </svg>
                    <span>Instagram</span>
                </a>
                <a class="social-link" href="https://facebook.com/pouchday" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 8h3V3h-3c-3 0-5 2-5 5v3H6v5h3v5h5v-5h3l1-5h-4V8c0-.7.3-1 1-1z"></path>
                    </svg>
                    <span>Facebook</span>
                </a>
            </div>
        </div>
    </main>
</Layout>

<style>
.success-message {
    text-align: center;
    padding-top: 3rem;
}

.success-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
}

.success-card {
    max-width: 500px;
    margin: 2rem auto;
    text-align: left;
}

.success-card ul {
    list-style: none;
    padding: 0;
}

.success-card li {
    padding: 0.5rem 0;
    position: relative;
    padding-left: 1.5rem;
}

.success-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--c-cyan);
    font-weight: bold;
}

.success-card .social-links {
    justify-content: flex-start;
    margin-top: 1rem;
}
</style>