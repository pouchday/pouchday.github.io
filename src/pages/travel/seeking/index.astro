---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Seeking Travelers">
    <h1>Seeking Travelers</h1>
    <p>We're looking for volunteers to carry packages on the following upcoming trips. Sign up below if you're available on one of these dates.</p>

    <div id="flights-wrap" class="flights-table-wrap">
        <table class="flights-table" aria-label="Upcoming trips">
            <thead id="flights-thead"></thead>
            <tbody id="flights-tbody">
                <tr><td colspan="99">Loading schedule…</td></tr>
            </tbody>
        </table>
    </div>

    <hr>

    <h2>Sign Up for a Trip</h2>
    <p>Select a trip from the schedule above, leave your email, and we'll be in touch.</p>

    <form id="seeking-form" action="https://formsubmit.co/pouchday-dev@proton.me" method="POST">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_subject" value="Traveler Sign-Up">
        <input type="hidden" name="_next" id="seeking-next" value="/travel/seeking/success/">

        <div class="form-group">
            <label for="field-trip">Select a Trip</label>
            <select name="trip" id="field-trip" required>
                <option value="" disabled selected>Loading trips…</option>
            </select>
        </div>

        <div class="form-group">
            <label for="field-email">Your Email</label>
            <input type="email" name="email" id="field-email" placeholder="you@example.com" required>
        </div>

        <button type="submit" class="btn-primary">Sign Up</button>
    </form>
</Layout>

<style>
.flights-table-wrap {
    overflow-x: auto;
    margin: 2rem 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--c-border);
}

.flights-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
}

.flights-table thead {
    border-bottom: 2px solid var(--c-border);
}

.flights-table th,
.flights-table td {
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 1px solid var(--c-border);
}

.flights-table th {
    background: linear-gradient(180deg, #f0f6ff 0%, #e8f2fc 100%);
    font-weight: 800;
    color: var(--c-navy);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
}

.flights-table tbody tr {
    transition: background-color 0.15s ease;
}

.flights-table tbody tr:nth-child(even) {
    background: #f8fbff;
}

.flights-table tbody tr:hover {
    background: color-mix(in srgb, var(--c-cyan) 8%, #fff);
}

.flights-table tbody tr:last-child td {
    border-bottom: none;
}

.status-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

.status-badge--open {
    background: color-mix(in srgb, #5cb85c 20%, #fff);
    color: #2d5a2d;
    border: 1px solid color-mix(in srgb, #5cb85c 40%, #fff);
}

.status-badge--full {
    background: color-mix(in srgb, #d9534f 20%, #fff);
    color: #7a2e2e;
    border: 1px solid color-mix(in srgb, #d9534f 40%, #fff);
}

@media (max-width: 768px) {
    .flights-table th,
    .flights-table td {
        padding: 0.75rem 0.75rem;
        font-size: 0.9rem;
    }
}
</style>

<script>
// Fix absolute redirect for FormSubmit
const seekingNext = document.getElementById('seeking-next');
if (seekingNext) {
    seekingNext.value = `${window.location.origin}/travel/seeking/success/`;
}

const FLIGHTS_TSV_URL = 'https://docs.google.com/spreadsheets/d/1pNKEJRMOZY2yTuOt91vOZ9qeRW5S9oVaF9NnkLsoEOc/export?gid=712744042&format=tsv';

function parseTSV(text) {
    const lines = text.trim().split('\n');
    const headers = lines[0].split('\t').map(h => h.trim());
    const rows = lines.slice(1)
        .map(line => line.split('\t').map(c => c.trim()))
        .filter(cols => cols.some(c => c));
    return { headers, rows };
}

function findIdx(headers, keywords, skip) {
    return headers.findIndex((h, i) => i !== skip && keywords.some(k => h.toLowerCase().includes(k)));
}

function statusBadge(text) {
    const lower = (text || '').toLowerCase();
    const cls = lower.includes('full') ? 'status-badge--full' : 'status-badge--open';
    return `<span class="status-badge ${cls}">${text || ''}</span>`;
}

fetch(FLIGHTS_TSV_URL)
    .then(r => r.text())
    .then(text => {
        const { headers, rows } = parseTSV(text);
        if (!rows.length) {
            document.getElementById('flights-tbody').innerHTML =
                '<tr><td colspan="99">No trips scheduled at this time.</td></tr>';
            document.getElementById('field-trip').innerHTML =
                '<option value="" disabled selected>No trips available</option>';
            return;
        }

        const dateIdx = findIdx(headers, ['date'], -1);
        const cityIdx = findIdx(headers, ['city', 'location', 'destination', 'mission', 'place', 'country'], dateIdx);
        const statusIdx = findIdx(headers, ['status'], Math.max(dateIdx, cityIdx));

        // Fall back to the first column that isn't date or status when no location column is matched
        const locationIdx = cityIdx >= 0 ? cityIdx :
            headers.findIndex((h, i) => i !== dateIdx && i !== statusIdx);

        // Sort by date if date column exists
        if (dateIdx >= 0) {
            rows.sort((a, b) => {
                const da = new Date(a[dateIdx] || '');
                const db = new Date(b[dateIdx] || '');
                return da - db;
            });
        }

        // Build visible columns (date if present, location, status if present)
        const visibleCols = [];
        if (dateIdx >= 0) visibleCols.push({ idx: dateIdx, label: headers[dateIdx] });
        if (locationIdx >= 0) visibleCols.push({ idx: locationIdx, label: headers[locationIdx] });
        if (statusIdx >= 0) visibleCols.push({ idx: statusIdx, label: headers[statusIdx] });
        // Fall back to showing all columns if we found nothing
        if (!visibleCols.length) {
            headers.forEach((h, i) => visibleCols.push({ idx: i, label: h }));
        }

        // Render table header
        document.getElementById('flights-thead').innerHTML =
            '<tr>' + visibleCols.map(c => `<th>${c.label}</th>`).join('') + '</tr>';

        // Render table rows
        document.getElementById('flights-tbody').innerHTML = rows.map(cols =>
            '<tr>' + visibleCols.map(c => {
                const val = cols[c.idx] || '';
                if (c.idx === statusIdx) return `<td>${statusBadge(val)}</td>`;
                return `<td>${val}</td>`;
            }).join('') + '</tr>'
        ).join('');

        // Populate the select dropdown
        const tripSelect = document.getElementById('field-trip');
        tripSelect.innerHTML = '<option value="" disabled selected>Select a trip…</option>';
        rows.forEach(cols => {
            const city = locationIdx >= 0 ? cols[locationIdx] : '';
            const date = dateIdx >= 0 ? cols[dateIdx] : '';
            if (!city && !date) return;
            const label = date ? `${date} – ${city}` : city;
            const opt = document.createElement('option');
            opt.value = label;
            opt.textContent = label;
            tripSelect.appendChild(opt);
        });
    })
    .catch(() => {
        document.getElementById('flights-tbody').innerHTML =
            '<tr><td colspan="99">Unable to load trip schedule.</td></tr>';
        document.getElementById('field-trip').innerHTML =
            '<option value="" disabled selected>Unable to load trips</option>';
    });
</script>